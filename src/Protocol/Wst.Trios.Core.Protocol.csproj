<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf"/>
        <PackageReference Include="Grpc.Net.Client"/>
        <PackageReference Include="Grpc.Tools" PrivateAssets="All"/>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\prelaunch\brokerside\order\entities.proto" ProtoRoot="Protos" >
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\order\service.proto" GrpcServices="Server,Client" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\order\create-order.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\order\get-order.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\order\get-orders.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\order\update-order.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\order\delete-order.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\trade\entities.proto" ProtoRoot="Protos" >
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\trade\service.proto" GrpcServices="Server,Client" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\trade\create-trade.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\trade\get-trade.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\trade\get-trades.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\trade\update-trade.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
        <Protobuf Include="Protos\prelaunch\brokerside\trade\delete-trade.proto" ProtoRoot="Protos">
            <Generator>MSBuild:Compile</Generator>
        </Protobuf>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Protos\prelaunch\brokerside\order" />
      <Folder Include="Protos\prelaunch\brokerside\trade" />
    </ItemGroup>

</Project>
