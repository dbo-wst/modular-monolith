ASPNETCORE_ENVIRONMENT=Local
ASPNETCORE_HTTP_PORTS=80
Persistence__ConnectionString=Server=<DB_SERVER>,1433;Database=<DB_NAME>;User Id=<DB_USER>;Password=<DB_PASSWORD>;TrustServerCertificate=True;

# Telemetry (wst-cicd otel/DOTNET.md). Local: otel-local.steubing.com; dev/stage/live: otel.steubing.com.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-local.steubing.com:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

# Background jobs (optional; defaults in appsettings.json run every job every 5 minutes).
# Jobs__Enabled=false switches the scheduler off; crons are Quartz expressions with seconds.
# Jobs__Enabled=false
# Jobs__Heartbeat__Cron=0 0/5 * * * ?
# Jobs__Housekeeping__Enabled=false
