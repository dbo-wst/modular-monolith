<Project>
    <!-- Inherit the repository-wide settings (TargetFramework, Nullable, TreatWarningsAsErrors, ...). -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <!--
          xUnit1051 asks every call that accepts a CancellationToken to pass TestContext.Current.CancellationToken.
          Now that repositories/services accept tokens this would fire on nearly every line of these in-memory
          tests for little benefit, so suppress it here while keeping all other warnings as errors.
        -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>
</Project>
